# ==============================================================================
# MAP BĐS — CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BẢN ĐỒ VỆ TINH & TIỆN ÍCH (GOOGLE MAPS PLATFORM)
# ------------------------------------------------------------------------------
# API Key của Google Cloud (Cần bật: "Maps Static API" và tùy chọn "Places API")
# Lấy key tại: https://console.cloud.google.com/google/maps-apis
# Lưu ý: Nếu để trống, hệ thống sẽ tự động chuyển sang dùng ảnh vệ tinh sắc nét của
# ArcGIS / ESRI World Imagery (hoàn toàn miễn phí, không cần đăng ký tài khoản).
GOOGLE_MAPS_API_KEY=

# Độ zoom vệ tinh mặc định khi quét bản đồ (14: quận/huyện, 16: khu phố/thửa đất, 17: sát nóc nhà)
MAP_SATELLITE_ZOOM=16

# Nguồn bản đồ ưu tiên: "auto" (thử Google trước nếu có key, tự chuyển ESRI), "google", hoặc "esri"
MAP_DEFAULT_PROVIDER=auto


# ------------------------------------------------------------------------------
# 2. AI KỊCH BẢN BĐS & PHỤ ĐỀ (GOOGLE GEMINI AI)
# ------------------------------------------------------------------------------
# Dùng để tự động tạo file input.json chuẩn từ văn bản mô tả BĐS của môi giới (npm run script:ai)
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model Gemini tạo kịch bản: gemini-2.5-flash hoặc gemini-1.5-flash
GEMINI_SCRIPT_MODEL=gemini-2.5-flash


# ------------------------------------------------------------------------------
# 3. GIỌNG NÓI THUYẾT MINH TIẾNG VIỆT (TTS - TEXT TO SPEECH)
# ------------------------------------------------------------------------------
# Engine mặc định:
# - "cit-voice" : CIT Voice Studio chạy offline cục bộ trên máy (48kHz, chất giọng Nam/Nữ Bắc - Nam)
# - "edge-tts"  : Microsoft Edge TTS online (hoàn toàn miễn phí, không cần key)
# - "gemini-tts": Giọng đọc Gemini Flash AI (cần GEMINI_API_KEY)
TTS_PROVIDER=cit-voice

# --- Cấu hình CIT Voice Studio (Offline) ---
# Tải và khởi chạy: E:\CIT Voice Studio\CIT-Voice-Studio.exe
CIT_VOICE_ENDPOINT=http://127.0.0.1:8001
# Tên giọng: "Minh Đức" (Nam Bắc tin tức), "Hải Đăng" (Nam Bắc tự nhiên), "Mai Anh" (Nữ Bắc), "Thùy Dung" (Nữ Nam), v.v.
CIT_VOICE=Minh Đức
CIT_VOICE_SPEED=1.0
CIT_VOICE_TEMPERATURE=0.7

# --- Cấu hình Microsoft Edge TTS (Online miễn phí) ---
# Danh sách giọng: vi-VN-NamMinhNeural (Nam), vi-VN-HoaiMyNeural (Nữ)
EDGE_TTS_VOICE=vi-VN-NamMinhNeural
EDGE_TTS_RATE=+0%

# --- Cấu hình Gemini Flash TTS (Tùy chọn) ---
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore


# ------------------------------------------------------------------------------
# 4. CẤU HÌNH RENDER VIDEO & ĐỒ HỌA (REMOTION)
# ------------------------------------------------------------------------------
# Số luồng render video đồng thời (mặc định: 2 để tránh nghẽn GPU/CPU)
RENDER_CONCURRENCY=2

# Tốc độ khung hình mặc định (fps)
DEFAULT_FPS=24
